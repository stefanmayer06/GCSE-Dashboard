# OpenRouter powers both subject tutors and English extended-answer marking.
OPENROUTER_API_KEY=
# Google: Gemma 4 26B A4B (free) — swap for any OpenRouter model id.
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free

# Combined application server and persistent progress location.
PORT=3000
DATA_DIR=server/data

# Optional OAuth2 sign-in (Google, GitHub, etc). Leave blank for
# password-only login. The local admin account (admin / admin) always exists.
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_AUTHORIZE_URL=
OAUTH_TOKEN_URL=
OAUTH_USERINFO_URL=
OAUTH_SCOPE=openid profile email
OAUTH_PROVIDER_NAME=OAuth
