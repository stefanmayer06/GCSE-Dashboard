{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "general": {
      "model": "openai/gpt-5.6-luna",
      "variant": "max"
    },
    "explore": {
      "model": "openai/gpt-5.6-luna",
      "variant": "max"
    }
  },
  "mcp": {
    "reddit": {
      "type": "local",
      "command": ["npx", "-y", "reddit-mcp-server"],
      "enabled": true,
      "environment": {
        "REDDIT_AUTH_MODE": "anonymous",
        "REDDIT_SAFE_MODE": "standard"
      }
    }
  }
}
