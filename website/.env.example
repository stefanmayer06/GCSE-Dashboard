# OpenRouter powers both subject tutors and English extended-answer marking.
OPENROUTER_API_KEY=
# Qwen 3.7 Flash — swap for any OpenRouter model id.
OPENROUTER_MODEL=qwen/qwen3.7-flash

# Combined application server.
PORT=3000
APP_URL=http://localhost:3000

# Local and Docker storage defaults. DATA_DIR is only used by the JSON driver.
STORAGE_DRIVER=json
DATA_DIR=server/data

# The local/Docker default seeds admin / admin. Always use a strong secret in production.
ADMIN_PASSWORD=admin
SESSION_SECRET=

# Vercel production uses the Neon Marketplace integration, which supplies
# DATABASE_URL. Set STORAGE_DRIVER=postgres, a strong ADMIN_PASSWORD and a
# random SESSION_SECRET (32+ characters). Set APP_URL to the canonical HTTPS
# URL, including the free *.vercel.app URL, and do not set DATA_DIR.
DATABASE_URL=

# Optional OAuth2 sign-in (Google, GitHub, etc). Leave blank for
# password-only login.
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_AUTHORIZE_URL=
OAUTH_TOKEN_URL=
OAUTH_USERINFO_URL=
OAUTH_SCOPE=openid profile email
OAUTH_PROVIDER_NAME=OAuth

# Experimental Supabase migration driver. Keep STORAGE_DRIVER=json or postgres
# until the Supabase migration has been rehearsed and approved for cutover.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_OAUTH_PROVIDER=
SUPABASE_DB_URL=
SUPABASE_DB_SSL=require

# Public Vite values used by the browser Supabase client. The publishable key
# is safe for browser use; never put SUPABASE_SECRET_KEY in VITE_* variables.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=
