{
  "name": "gcse-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "One revision dashboard for AQA GCSE Maths and English Language",
  "workspaces": [
    "server",
    "clients/maths",
    "clients/english"
  ],
  "scripts": {
    "dev": "concurrently -n server,maths,english -c blue,magenta,yellow \"npm run dev -w server\" \"npm run dev -w clients/maths\" \"npm run dev -w clients/english\"",
    "build": "npm run build -w clients/maths && npm run build -w clients/english",
    "build:vercel": "node scripts/build-vercel.mjs",
    "db:migrations:list": "supabase migration list --linked",
    "db:migrations:push": "supabase db push --linked",
    "start": "npm run start -w server",
    "test": "npm test -w server",
    "test:foundation": "node --test server/test/foundation-bank.test.js",
    "test:higher": "node --test server/test/higher-bank.test.js",
    "explainers:check": "node scripts/validate-explainers.mjs",
    "art:export": "node scripts/export-art.mjs",
    "design:shots": "node scripts/capture-design-shots.mjs",
    "design:doc": "node scripts/build-design-doc.mjs",
    "test:ui": "playwright test",
    "support:list": "node scripts/support-ops.mjs list",
    "support:prune": "node scripts/support-ops.mjs prune",
    "acquisition:report": "node scripts/acquisition-report.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "concurrently": "^9.1.0",
    "supabase": "^2.115.0"
  }
}
