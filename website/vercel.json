{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "server/src/storage/schema.sql"
    }
  },
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/maths-higher",
      "destination": "/maths-higher/index.html"
    },
    {
      "source": "/maths-higher/:path((?!assets(?:/|$))(?!.*\\.[^/]+$).*)",
      "destination": "/maths-higher/index.html"
    },
    {
      "source": "/maths",
      "destination": "/maths/index.html"
    },
    {
      "source": "/maths/:path((?!assets(?:/|$))(?!.*\\.[^/]+$).*)",
      "destination": "/maths/index.html"
    },
    {
      "source": "/english",
      "destination": "/english/index.html"
    },
    {
      "source": "/english/:path((?!assets(?:/|$))(?!.*\\.[^/]+$).*)",
      "destination": "/english/index.html"
    },
    {
      "source": "/subjects",
      "destination": "/subjects.html"
    }
  ]
}
